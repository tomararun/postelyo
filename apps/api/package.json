{
  "name": "@postelyo/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:api": "tsx --conditions=development watch --env-file-if-exists=../../.env src/main-api.ts",
    "dev:worker": "tsx --conditions=development watch --env-file-if-exists=../../.env src/main-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "cross-env VITEST_INTEGRATION=1 vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development --env-file-if-exists=../../.env src/infra/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "preflight": "tsx --conditions=development --env-file-if-exists=../../.env src/tools/preflight.ts",
    "notion:template": "tsx --conditions=development --env-file-if-exists=../../.env src/tools/create-notion-template.ts",
    "seed": "tsx --conditions=development --env-file-if-exists=../../.env src/tools/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/sensible": "^6.0.5",
    "@postelyo/publishing-core": "0.1.0",
    "@sentry/node": "^10.75.3",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.10",
    "pg-boss": "^12.33.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "sharp": "^0.35.4",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^17.10.0-beta.17",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.1"
  }
}
