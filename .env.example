# Copy to .env for local development. Never commit .env.
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
APP_BASE_URL=http://localhost:3000

# PostgreSQL (docker compose default)
DATABASE_URL=postgres://postelyo:postelyo@localhost:5432/postelyo

# Session / magic-link signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef

# Credential encryption master keys: "<id>:<base64 32 bytes>", comma-separated, first is current.
# Generate a key with: openssl rand -base64 32   (dev-only value below; rotate by prepending a new id)
ENCRYPTION_KEYS=dev1:ZGV2LW9ubHktZGV2LW9ubHktZGV2LW9ubHktZGV2MTIz

# Email. log = print to the console (magic links appear in the api log).
# smtp = deliver via SMTP_URL (docker compose Mailpit: smtp://localhost:1025, UI at http://localhost:8025)
MAIL_TRANSPORT=log
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Postelyo <no-reply@postelyo.local>

# fake = FakeProvider, no external calls. live = real LinkedIn adapter (milestone 0.5).
PROVIDER_MODE=fake

# LinkedIn OAuth app (developer portal). Redirect URL to register: $APP_BASE_URL/oauth/linkedin/callback
# Leave both empty to disable the LinkedIn connect button. Never commit real values.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Operational alerts recipient (product decision P5). Optional in development.
ALERT_EMAIL=

# Notion integration webhooks (optional; polling works without them). Create the subscription in the
# Notion integration settings pointing at $APP_BASE_URL/webhooks/notion, copy the verification token
# from the api log into this variable, restart, then enable per workspace (PATCH /v1/workspaces/:id
# {"notionWebhooks": true}).
NOTION_WEBHOOK_SECRET=

# Optional
# SENTRY_DSN=
# Protects GET /metrics when set (>= 16 chars)
# METRICS_TOKEN=
# Set by the deploy pipeline; shown in heartbeats and logs
# APP_VERSION=

# X (Twitter) OAuth 2.0 app (developer portal, confidential client, user context). Redirect URL:
# $APP_BASE_URL/oauth/x/callback. Posting requires a paid API tier. Both or neither.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta app for Facebook Pages and Instagram (Facebook Login). Redirect URL: $APP_BASE_URL/oauth/meta/callback.
# Publishing permissions need Meta app review. Both or neither.
META_APP_ID=
META_APP_SECRET=

# Media storage. local = files under STORAGE_LOCAL_DIR served by the api at /media/*.
# s3 = S3-compatible (Cloudflare R2 in production; Instagram/Facebook fetch images by public URL).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/media
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=postelyo-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://media.example.com

# Notion public integration (Phase 3, "Connect with Notion"). Redirect URL: $APP_BASE_URL/oauth/notion/callback.
# The integration must pass Notion's review before other workspaces can install it. Both or neither.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Stripe (Phase 3). Test-mode keys for development; the webhook secret comes from the Stripe CLI or dashboard
# (endpoint: $APP_BASE_URL/webhooks/stripe). Price ids map plans to Stripe prices; a missing id hides the plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_AGENCY=

# Dashboard (apps/web). The browser talks to the web app; it proxies auth/API calls to the api process.
# When the dashboard fronts the api, APP_BASE_URL above must be the dashboard's origin (e.g. http://localhost:3001).
API_INTERNAL_URL=http://localhost:3000

# AI assistance (Phase 6). Anthropic by default when the key is set; AI_PROVIDER=fake never calls a provider.
# Workspaces still need the "AI assistance" switch on and a plan with an AI token budget.
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=claude-opus-5
